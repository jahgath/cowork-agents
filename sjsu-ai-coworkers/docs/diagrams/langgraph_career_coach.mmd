---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	load_context(load_context)
	discover_opportunities(discover_opportunities)
	analyze_fit(analyze_fit)
	plan_assessment(plan_assessment)
	select_question(select_question)
	ask(ask)
	evaluate_answer(evaluate_answer)
	adapt_difficulty(adapt_difficulty)
	build_report(build_report)
	__end__([<p>__end__</p>]):::last
	__start__ --> load_context;
	adapt_difficulty -.-> build_report;
	adapt_difficulty -.-> select_question;
	analyze_fit --> plan_assessment;
	ask --> evaluate_answer;
	discover_opportunities --> analyze_fit;
	evaluate_answer --> adapt_difficulty;
	load_context --> discover_opportunities;
	plan_assessment --> select_question;
	select_question -.-> ask;
	select_question -.-> build_report;
	build_report --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
